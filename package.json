{
  "name": "kliseer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3999",
    "dev:landing": "npm run build:motion && astro dev --root landing",
    "build": "next build && npm run build:landing",
    "build:landing": "npm run build:motion && astro build --root landing",
    "build:motion": "npm run check:landing && esbuild landing/src/scripts/main.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=landing/public/motion/main.js",
    "preview:landing": "astro preview --root landing",
    "check:landing": "tsc --noEmit -p landing/tsconfig.json",
    "start": "next start",
    "lint": "eslint",
    "db:init": "tsx --env-file=.env.local scripts/db-init.ts",
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "check": "tsx scripts/tier.check.ts && tsx scripts/account.check.ts && tsx scripts/contacts.check.ts && tsx scripts/chat-workspace.check.ts && tsx scripts/routing.check.ts"
  },
  "dependencies": {
    "lenis": "1.3.27",
    "next": "16.4.5",
    "openai": "7.52.0",
    "postgres": "4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.4.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.541",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "5.18.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "remotion": "^4.0.541",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
